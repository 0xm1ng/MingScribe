{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MingScribe",
  "version": "0.1.0",
  "identifier": "com.mingscribe.app",
  "build": {
    "beforeDevCommand": "node tools/dev_server.js",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MingScribe",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
